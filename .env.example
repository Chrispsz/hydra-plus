# Hydra API — required for login, library sync, downloads and Hydra cloud saves
MAIN_VITE_API_URL=
MAIN_VITE_AUTH_URL=

# Fork update feed (GitHub Releases of YOUR fork)
MAIN_VITE_UPDATE_OWNER=
MAIN_VITE_UPDATE_REPO=

# Google OAuth "Desktop app" client (console.cloud.google.com, Drive API enabled).
# Required to enable the "Hydra Plus Saves" Google Drive cloud provider.
# The client SECRET is required too: Google's token endpoint refuses the
# authorization-code exchange without it, even for desktop clients.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

RENDERER_VITE_REAL_DEBRID_REFERRAL_ID=
RENDERER_VITE_TORBOX_REFERRAL_CODE=
